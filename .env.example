# Copy this file to `.env` and fill in your own values.
# These are EXPO_PUBLIC_* vars, so they are embedded in the client build.
# The app runs on mock data if these are unset (see src/api/main.js).

# Both must name the SAME environment — Main only accepts JWTs issued by its
# matching Identity. Production drops the "-staging" suffix.

# HitchLink Identity service (auth)
EXPO_PUBLIC_API_BASE_URL=https://auth-staging.gethitchlink.com

# HitchLink Main service (loads, chat, etc.)
EXPO_PUBLIC_API_MAIN_URL=https://api-staging.gethitchlink.com

# Crash reporting (optional). Unset = src/lib/observability.js is a no-op and
# the app reports nothing when it crashes. For real builds set it as an EAS
# secret rather than here, so it covers every profile and stays uncommitted:
#   eas secret:create --scope project --name EXPO_PUBLIC_SENTRY_DSN --value <dsn>
# `npm run check:observability` warns on any store-bound build without it.
EXPO_PUBLIC_SENTRY_DSN=
